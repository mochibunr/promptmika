    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3"
