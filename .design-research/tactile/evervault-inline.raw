.ev-tl-desktop-row { display: flex; }
.ev-tl-compact-row { display: none; }
@container (max-width: 420px) {
	.ev-tl-desktop-row { display: none; }
	.ev-tl-compact-row { display: flex; }
	/* !important is required: each row&#x27;s motion.div sets display:flex inline, and an inline style
	   always wins over an external stylesheet rule regardless of selector specificity — a plain
	   (non-important) rule here would never be able to hide it. */
	.ev-tl-extra-row { display: none !important; }
}


