Contact","/Users/baptisteschlienger/Documents/Projects/walkie-talkie-website/src/app/components/Contact.js"),__REACT_HOT_LOADER__.register(S,"default","/Users/baptisteschlienger/Documents/Projects/walkie-talkie-website/src/app/components/Contact.js"))}()},function(t,e,n){"use strict";function r(t){return t&&t.__esModule?t:{default:t}}function i(t,e){if(!(t instanceof e))throw new TypeError("Cannot call a class as a function")}function a(t,e){if(!t)throw new ReferenceError("this hasn't been initialised - super() hasn't been called");return!e||"object"!=typeof e&&"function"!=typeof e?t:e}function o(t,e){if("function"!=typeof e&&null!==e)throw new TypeError("Super expression must either be null or a function, not "+typeof e);t.prototype=Object.create(e&&e.prototype,{constructor:{value:t,enumerable:!1,writable:!0,configurable:!0}}),e&&(Object.setPrototypeOf?Object.setPrototypeOf(t,e):t.__proto__=e)}Object.defineProperty(e,"__esModule",{value:!0});var s=function(){function t(t,e){for(var n=0;n<e.length;n++){var r=e[n];r.enumerable=r.enumerable||!1,r.configurable=!0,"value"in r&&(r.writable=!0),Object.defineProperty(t,r.key,r)}}return function(e,n,r){return n&&t(e.prototype,n),r&&t(e,r),e}}(),l=n(0),c=r(l),u=n(155),f=r(u),p=n(3),h=r(p),m=n(211),d=r(m);n(2);var y=new h.default({en:{rulesTitle:"Walkie-talkie Rule Book",harassmentTitle:"Harassment",harassmentDescription:"Treat others the way you would like to be treated. Those who abuse or harass other users will be suspended or removed from Walkie-talkie. We do not tolerate predatory behavior of any kind: no bullying, no stalking, no verbal or written intimidation.",violenceTitle:"Violence",violenceDescription:"Violence and graphic content has no home at Walkie-talkie. Promoting violence is unacceptable. Threatening violence is unacceptable. Glorifying violence is unacceptable. Encouraging suicide or self-harm is strictly prohibited. Please alert Walkie-talkie immediately of any suicidal situation, and we will attempt to aid in finding immediate help.",hatespeechTitle:"Hate Speech",hatespeechDescription:"Our community spans all seven continents and includes users of every color and creed. We do not condone racism, threats, or intimidation of other users, period. Those who single out others based on their race, religion, ethnicity, gender, place of birth, or sexual orientation will be removed from our community.",privateTitle:"Private Information",privateDescription:"Keep private information private. Don't advertise it. Don't share it, even if it's your own. Broadcasting other people's phone numbers, email addresses, passwords, driver's licenses, home addresses, social security numbers, and passports, among others, is prohibited. Broadcasting your own private information is strongly discouraged.",promotionTitle:"Promotion or Solicitation",promotionDescription:"Users join Walkie-talkie to connect with others around the globe — not to be solicited. Your product, political campaign, pitch or advertisement is not welcome here. Feel free to share what you're up to with friends and invite them to events of mutual interest, but don't make solicitation a part of your activities.",prostitutionTitle:"Prostitution and Trafficking",prostitutionDescription:"Offering or advertising sexual services in exchange for money is not allowed. Promoting non-consensual sex is prohibited. Those who facilitate or promote human trafficking will be removed from Walkie-talkie at once.",scammingTitle:"Scamming",scammingDescription:"Trying to defraud someone else into giving you their private information is not okay on our app. Sharing your own financial information to dupe another user into paying you illegally is also not okay. No exceptions.",impersonationTitle:"Impersonation",impersonationDescription:"You're great. We love you the way you are. Don't impersonate someone else or create a parody account. If you do, we may delete both the parody account and your account and say our goodbyes.",minorsTitle:"Minors",minorsDescription:"Walkie-talkie has an age requirement of 13. If you're under 13 years old, we look forward to welcoming you soon, but not yet. Profile pics of unaccompanied minors are prohibited. Broadcasting or glorifying harm or abuse of minors is strictly prohibited.",copyrightTitle:"Copyright and Trademark Infringement",copyrightDescription:"We work hard to make Walkie-talkie a fun and original environment for you. Our logo and user experience is ours, not yours to take and display elsewhere. Likewise, don't pirate other people's stuff and display it as your own on your profile."},fr:{rulesTitle:"Talkie-walkie règles d’usage",harassmentTitle:"Harcèlement",harassmentDescription:"Ne faites pas aux autres ce que vous n'aimeriez pas qu’on vous fasse. Ceux qui abusent ou harcèlent d’autres utilisateurs seront suspendus ou bannis de Talkie-walkie. Nous ne tolérerons aucun comportement prédateur de toute sorte : pas de harcèlement, pas d'intimidation verbale ou écrite.",violenceTitle:"Violence",violenceDescription:"La violence n’a pas sa place dans Talkie-walkie. Promouvoir la violence est inacceptable. Menacer est inacceptable. Glorifier la violence est inacceptable. Il est strictement interdit d'encourager le suicide ou l'automutilation. Veuillez avertir immédiatement l’équipe Talkie-walkie de toute situation suicidaire et nous essaierons de vous aider à trouver une aide immédiate.",hatespeechTitle:"Discours haineux",hatespeechDescription:"Notre communauté s’étend sur sept continents et inclut des utilisateurs de toutes les couleurs et croyances. Nous ne tolérons pas le racisme, les menaces ou l'intimidation d'autres utilisateurs. Ceux qui distinguent les autres en fonction de leur race, religion, origine ethnique, sexe, lieu de naissance ou orientation sexuelle seront exclus de notre communauté.",privateTitle:"Information privée",privateDescription:"Gardez vos informations privées. N'en faites pas la publicité. Ne les partagez pas, même si ce sont les vôtres. La diffusion des numéros de téléphone, des adresses e-mail, des mots de passe, des permis de conduire, des adresses personnelles, des numéros de sécurité sociale et des passeports, entre autres, d'autres personnes est interdite. La diffusion de vos propres informations privées est fortement déconseillée.",promotionTitle:"Promotion et solicitation",promotionDescription:"Les utilisateurs rejoignent Talkie-walkie pour se connecter avec d'autres personnes dans le monde entier - pas pour être sollicités. Votre produit, campagne politique, argumentaire ou publicité ne sont pas les bienvenus ici. N'hésitez pas à partager vos activités avec vos amis et à les inviter à des événements d'intérêt commun, mais n'intégrez pas la sollicitation à vos activités.",prostitutionTitle:"Prostitution et traffic",prostitutionDescription:"L'offre ou la publicité de services sexuels en échange d'argent n'est pas autorisée. La promotion de relations sexuelles non consensuelles est interdite. Ceux qui facilitent ou encouragent la traite des êtres humains seront immédiatement banni de Talkie-walkie.",scammingTitle:"Escroquerie",scammingDescription:"Essayer de forcer quelqu'un pour qu'il vous donne ses informations privées n'est pas acceptable sur notre application. Partager vos propres informations financières pour duper un autre utilisateur et le faire payer illégalement est inacceptable.",impersonationTitle:"Impersonalisation",impersonationDescription:"Ne vous faites pas passer pour quelqu'un d'autre et ne créez pas de compte parodique. Si vous le faites, il est possible que nous supprimions à la fois le compte parodique et votre compte personnel.",minorsTitle:"Mineurs",minorsDescription:"Talkie-walkie a une condition d'âge minimum de 13 ans. Si vous avez moins de 13 ans, nous espérons vous accueillir bientôt. Les photos de profil des mineurs non accompagnés sont interdites. La diffusion ou abus envers des mineurs est strictement interdite.",copyrightTitle:"Violation des droits d'auteur et des marques",copyrightDescription:"Nous travaillons dur pour faire de Talkie-walkie un environnement amusant et original pour vous. Notre logo et expérience utilisateur nous appartiennent. De même, ne piratez pas les propriétés des autres dans le but de les afficher comme étant les vôtres sur votre profil."},es:{rulesTitle:"Walkie-talkie reglas de uso",harassmentTitle:"Acoso/Intimidación",harassmentDescription:"Trate a los demás como le gustaría que lo trataran a usted. Aquellos que abusen o acosen a otros usuarios serán suspendidos o excluidos  de Walkie-talkie. No toleramos el comportamiento depredador de ningún tipo: ningún acoso, ningúna intimidación verbal o escrita.",violenceTitle:"Violencia",violenceDescription:"La violencia no tiene lugar en Walkie-talkie. Promover la violencia es inaceptable. Amenazar es inaceptable. Glorificar la violencia es inaceptable. Está estrictamente prohibido alentar el suicidio o la autolesión. Por favor, avise al equipo de Walkie-talkie inmediatamente de cualquier situación suicida y le asistiremos para encontrar ayuda inmediata.",hatespeechTitle:"Discurso de odio",hatespeechDescription:"Nuestra comunidad abarca los siete continentes e incluye usuarios de todos los estilos y creencias. No toleramos el racismo, las amenazas o la intimidación de otros usuarios. Las personas que señalen a otras por su raza, religión, etnia, género, lugar de nacimiento u orientación sexual serán excluidos de nuestra comunidad.",privateTitle:"Información privada",privateDescription:"Mantenga su información privada. No lo anuncie. No lo comparta, aunque sea suyo. Está prohibida la difusión de los números de teléfono, direcciones de correo electrónico, contraseñas, licencias de conducir, domicilios, números de seguro social y pasaportes, entre otras cosas, de otra gente. Se desaconseja estrechamente la difusión de su propia información privada.",promotionTitle:"Promoción y solicitación",promotionDescription:"Los usuarios se unen a Walkie-talkie para conectarse con otras personas del mundo entero, no para ser solicitados. Ningún producto, campaña política, lanzamiento o publicidad son bienvenidos aquí. Siéntase libre de compartir lo que está haciendo con amigos e invitarlos a eventos de interés mutuo, pero su solicitud no debe hacer parte de sus actividades.",prostitutionTitle:"Prostitución y tráfico",prostitutionDescription:"La oferta o publicidad de servicios sexuales por dinero no está permitida. Está prohibida la promoción de relaciones sexuales sin consentimiento. Aquellos que faciliten o promuevan el tráfico de personas serán inmediatamente excluidos de Walkie-Talkie.",scammingTitle:"Estafa/Fraude",scammingDescription:"Intentar defraudar a otra persona para que le proporcione su información privada está prohibido en nuestra aplicación. Compartir su propia información financiera para engañar a otro usuario para que le mande dinero ilegalmente también está prohibido.",impersonationTitle:"Impersonalización",impersonationDescription:"No pretenda ser otra persona ni cree una cuenta de parodia. Si lo hace, podemos eliminar tanto la cuenta de parodia como su cuenta personal.",minorsTitle:"Menores",minorsDescription:"Walkie-talkie tiene un requisito de edad de 13 años. Si tiene menos de 13 años, esperamos darle la bienvenida pronto. Se proscriben las fotos de perfil de menores no acompañados. La distribución o abuso hacia menores está estrictamente prohibida.",copyrightTitle:"Infracción de derechos de autor y marcas comerciales",copyrightDescription:"Trabajamos duro para hacer de Walkie-talkie un entorno divertido y original para ustedes. Nuestro logo y experiencia de usuarios nos pertenecen. Del mismo modo, no piratees las propiedades de otras personas ni las muestre como propias en su perfil."},de:{rulesTitle:"Walkie-Talkie Regelwerk",harassmentTitle:"Beleidigungen",harassmentDescription:"Behandle andere, wie du selbst behandelt werden möchtest. Diejenigen, die andere Spieler missbrauchen oder beleidigen, werden entfernt oder gebannt. Wir akzeptieren kein rücksichtsloses Verhalten jeglicher Art: kein Mobbing, kein Stalking, weder mündliche noch schriftliche Einschüchterungen.",violenceTitle:"Gewalt",violenceDescription:"Gewalt und graphische Inhalte haben bei Walkie-Talkie nichts zu suchen. Verbreitung von Gewalt ist inakzeptabel. Bedrohungen sind inakzeptabel. Das Glorifizieren von Gewalt ist inakzeptabel. Es ist strengstens verboten, Suizid oder Selbstverletzung zu bestärken. Allarmiere das Walkie-Talkie Team umgehend bei jeglichen suizidären Anzeichen, damit wir versuchen können euch zu helfen und sofortige Unterstützung zu finden.",hatespeechTitle:"Hassrede",hatespeechDescription:"Unsere Community ist verteilt über alle sieben Kontinente und besteht aus Usern aller Hautfarben und Glaubensrichtungen. Wir tolerieren keinen Rassismus, Drohungen oder Einschüchterungen anderer User. Diejenigen, die andere auf Grund ihrer Hautfarbe, Religion, Ethnie, Geschlecht, Herkunftsort oder sexuellen Orientierung abwerten, werden von unserer Community ausgeschlossen.",privateTitle:"Vertrauliche Informationen",privateDescription:"Behalten Sie vertrauliche Informationen für sich. Bewerben Sie sie nicht. Teilen Sie sie nicht, selbst wenn es sich um Ihre eigenen persönlichen Daten handelt. Das Verbreiten von Telefonnummern, E-Mailadressen, Passwörtern, Führerscheinen, persönlichen Adressen, Sozialversicherungsnummern und von Reisepässen anderer Personen, ist untersagt. Vom Verbreiten Ihrer eigenen persönlichen Informationen raten wir Ihnen strengstens ab.",promotionTitle:"Promotion und Bewerbung",promotionDescription:"Die User treten Walkie-Talkie bei, um sich mit anderen Menschen der ganzen Welt zu connecten – nicht um umworben zu werden. Ihr Produkt, politische Kampagne, Pitch oder Werbung ist bei uns nicht willkommen. Teilen Sie Ihre Aktivitäten gerne mit Freunden und laden Sie sie zu Veranstaltungen von gemeinsamem Interesse ein, aber machen Sie Werbung nicht zu einem Teil der Events.",prostitutionTitle:"Prostitution und Menschenhandel",prostitutionDescription:"Das Anbieten oder Bewerben von sexuellen Dienstleistungen gegen Geld ist nicht gestattet. Die Werbung für nicht einvernehmlichen Sex ist verboten. Personen, die Menschenhandel erleichtern oder fördern, werden sofort von Walkie-Talkie entfernt.",scammingTitle:"Betrug",scammingDescription:"Illegale Geldtransfers werden auf unserer App nicht geduldet. Der Versuch Andere dazu zu zwingen ihre persönlichen Daten mit Ihnen zu teilen, oder das Teilen ihrer eigenen Bankdaten, um einen anderen User illegaler Weise für Sie überweisen zu lassen ist inakzeptabel.",impersonationTitle:"Imitation",impersonationDescription:"Sie sind großartig so wie Sie sind! Geben Sie sich nicht als jemand anderes aus und erstellen Sie keinen Fake-Account. Wenn Sie dies tun, können wir sowohl den Fake-Account als auch Ihr Konto löschen.",minorsTitle:"Minderjährige",minorsDescription:"Walkie-Talkie hat ein Mindestalter von 13 Jahren. Wenn Sie unter 13 Jahre alt sind, hoffen wir, Sie bald begrüßen zu dürfen. Profilbilder von unbeaufsichtigten Minderjährigen sind verboten. Das Ausstrahlen oder Verherrlichen von Missbrauch an Minderjährigen ist strengstens untersagt.",copyrightTitle:"Urheberrechts- und Markenverletzung",copyrightDescription:"Wir arbeiten hart daran, Walkie-Talkie zu einer unterhaltsamen und originellen Umgebung für Sie zu machen. Unser Logo und unsere User-Experience gehören uns, nicht Ihnen, um sie an anderer Stelle anzuzeigen. Berauben Sie auch nicht andere User und zeigen Sie keine fremden Inhalte in Ihrem Profil als Ihre eigenen an."}}),g=function(t){function e(t){return i(this,e),a(this,(e.__proto__||Object.getPrototypeOf(e)).call(this,t))}return o(e,t),s(e,[{key:"componentDidMount",value:function(){}},{key:"render",value:function(){return c.default.createElement("div",{className:"container-rules"},c.default.createElement("div",{className:"rules-heading"},c.default.createElement("div",null,y.rulesTitle),c.default.c